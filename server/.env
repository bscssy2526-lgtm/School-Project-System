# Copy to .env and adjust for your XAMPP MySQL
# Defaults work for fresh XAMPP (root, no password)

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=announcement_management_db

# Optional: JWT secret for auth tokens (change in production!)
# JWT_SECRET=your-secret-key
# Optional: token/session lifetime (examples: 2h, 12h, 7d) - shorter = more frequent re-login
# Default is 12h; set to 2h for stricter session timeout
JWT_EXPIRES_IN=2h

# Encryption: 32-character key for AES-256 encryption of sensitive data (phone numbers)
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, defaults to a weak key (DO NOT USE IN PRODUCTION)
ENCRYPTION_KEY=296d9293530e75503e737c384c89928687b1628024be0866a004c40baeb16243

# SMS gateway (when Admin posts school-wide announcement, SMS is sent to students with phone_num)
# Phone numbers in DB can be 09XXXXXXXXX (Philippines); they are sent as +639XXXXXXXXX
SMS_GATEWAY_URL=http://192.168.1.10:8080/message
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=your_password_here

# Data retention policy
# PHONE_NUMBER_RETENTION_YEARS=4  # Delete phone numbers after 4 years (default)

# Ahasend Email Configuration
AHASEND_ACCOUNT_ID=d2b35e7a-fa8f-4111-8557-6808a171e38d
AHASEND_SECRET_KEY=aha-sk-pd4zW7Mzfzskv02NvEDDAYrV7n5RWgG-TEmPpo15yhjCgVpOvilN_JCs18LW2Zgi
AHASEND_FROM_EMAIL=noreply@diaznotify.online
AHASEND_FROM_NAME=Diaz College Integrated Announcement Management System
